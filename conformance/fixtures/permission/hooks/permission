#!/usr/bin/env python3
"""a minimal HCP hook exercising the permission gate. it registers one tool and an on_permission
handler that DENIES any call whose `name` argument carries the forbidden sentinel (allowing every
other call). a conformant host MUST refuse the denied call before the tool runs (SPEC on_permission:
an allow/deny decision short-circuits the interactive prompt)."""

import json
import sys

FORBIDDEN = "_forbidden_"

stage = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    ctx = json.load(sys.stdin)
except Exception:
    ctx = {}


def arg_name():
    return (ctx.get("args") or {}).get("name", "")


if stage == "discover":
    # declare on_permission so the host arms the gate; the tool lets the model trigger a call.
    print(json.dumps({
        "name": "permission",
        "stages": ["on_permission"],
        "tools": [{
            "name": "touch",
            "description": "record a name",
            "parameters": {"name": {"type": "string", "description": "the name to record"}},
            "permission": {"arg": "name"},
        }],
    }))
elif stage == "on_permission":
    if FORBIDDEN in arg_name():
        print(json.dumps({"decision": "deny", "reason": f"blocked by policy: {arg_name()}"}))
elif stage == "execute_tool":
    print(json.dumps({"result": f"recorded {arg_name()}"}))
